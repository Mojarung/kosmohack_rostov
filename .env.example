# Ключи для языковой модели. Файл .env в git не попадает (см. .gitignore),
# скопируйте этот пример: cp .env.example .env — и подставьте свой ключ.
#
# Без ключа сервис работает полностью: объяснения и ответы агента формируются по правилам,
# на тех же числах, только без связного текста.

# Ollama Cloud: ключ из личного кабинета https://ollama.com
OLLAMA_API_KEY=

# Модель. По умолчанию gemma4:31b — из бесплатных облачных она отвечала быстрее всех
# (0.8 с на короткий ответ против 2.7 с у gpt-oss:20b).
NDVI_LLM_MODEL=gemma4:31b
